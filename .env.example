# Root Environment Variable Overview for Vidyut Monorepo
#
# Backend: apps/server/.env (copy from apps/server/.env.example)
# Frontend: apps/web/.env (copy from apps/web/.env.example)

# Database:
DATABASE_URL="postgresql://vidyut:vidyut_password@localhost:5433/vidyut_db"

# Backend server:
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Frontend API target:
VITE_API_URL="http://localhost:3001/api/v1"
