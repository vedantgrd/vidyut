# PostgreSQL connection string
# NOTE: Use port 5433 when using the included docker-compose.yml, or 5432 for native local/cloud Postgres
DATABASE_URL="postgresql://vidyut:vidyut_password@localhost:5433/vidyut_db"

# JWT Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET="change-me-to-a-secure-random-64-character-string"
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-64-character-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server Configuration
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# File Upload Storage (Local directory or persistent mount path)
STORAGE_PATH="./uploads"

# Optional Email Service (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@vidyut.in"
