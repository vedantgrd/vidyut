# PostgreSQL connection string
# NOTE: Use port 5433 when using the included docker-compose.yml, or 5432 for native local/cloud Postgres
DATABASE_URL="postgresql://vidyut:vidyut_password@localhost:5433/vidyut_db"

# JWT Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET="change-me-to-a-secure-random-64-character-string"
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-64-character-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server Configuration
PORT=3001
NODE_ENV="development" # Set to "production" in live deployment
FRONTEND_URL="http://localhost:5173" # Comma-separated for multiple origins: "https://vidyut.vercel.app,http://localhost:5173"
COOKIE_SAME_SITE="Lax" # Set to "None" when frontend & backend are on separate domains in production

# File Upload Storage
STORAGE_DRIVER="local" # "local" for persistent disk volume, or "s3" for AWS S3 / Cloudflare R2
STORAGE_PATH="./uploads" # Directory when STORAGE_DRIVER="local"

# Cloud Object Storage (Required when STORAGE_DRIVER="s3" or running on ephemeral cloud instances)
S3_BUCKET=""
S3_REGION="auto" # "auto" for Cloudflare R2, or e.g. "ap-south-1" for AWS S3
S3_ENDPOINT="" # Leave empty for AWS S3; for Cloudflare R2: "https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="vidyut-vault"
S3_FORCE_PATH_STYLE="false"

# Optional Email Service (Resend)
RESEND_API_KEY="" # e.g. "re_123456789"
FROM_EMAIL="noreply@vidyut.in"
